# Copy this file to .env and fill only the credentials you use.
# Never commit .env.

# Optional shared token for local UI/API protection.
# Set this in the environment or as api_token in config/secrets.yaml.
# Do not pass it as an argument to run-cycle; process listings would show it.
JOB_AGENT_API_TOKEN=

# Job source credentials (only required for the corresponding source).
# Prefer Settings → Source API keys, which writes gitignored config/secrets.yaml.
# These variables still apply when that file has no value for the key.
# A blank variable does not hide a value in this file.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
THEMUSE_API_KEY=
GOOGLE_MAPS_KEY=

# LLM providers. OpenRouter is the default. Settings can change the model
# (default openrouter/free) and the provider order.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Optional runtime path overrides.
# JOBAGENT_DATA_DIR=
# JOBAGENT_DATABASE_PATH=
# JOB_AGENT_ROOT_PATH=
