# Copy this file to .env and fill only the credentials you use.
# Never commit .env.

# Optional shared token for local UI/API protection.
JOB_AGENT_API_TOKEN=

# Job source credentials (only required for the corresponding source).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
THEMUSE_API_KEY=

# LLM providers. Configure the provider in config/settings.yaml.
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Optional runtime path overrides.
# JOBAGENT_DATA_DIR=
# JOBAGENT_DATABASE_PATH=
# JOB_AGENT_ROOT_PATH=
